artigos = []

while True:
    print("\n=== WIKICRUD ===")
    print("1 - Criar")
    print("2 - Ler")
    print("3 - Pesquisar")
    print("4 - Editar")
    print("5 - Apagar")
    print("6 - Ver todos")
    print("0 - Sair")
    op = input("Opção: ").strip()

    if op == "1":
        titulo = input("Título: ").strip()
        texto = input("Texto: ").strip()
        if not titulo or not texto:
            print("Título e texto são obrigatórios.")
            continue
        artigos.append({"titulo": titulo, "texto": texto})
        print(f"Artigo criado na posição {len(artigos)}!")

    elif op == "2":
        if not artigos:
            print("Nenhum artigo cadastrado.")
            continue
        try:
            n = int(input(f"Qual artigo (1 a {len(artigos)})? ").strip())
        except ValueError:
            print("Número inválido.")
            continue
        if n < 1 or n > len(artigos):
            print("Artigo não existe.")
            continue
        artigo = artigos[n - 1]
        print(f"\n{artigo['titulo']}\n{artigo['texto']}")

    elif op == "3":
        if not artigos:
            print("Nenhum artigo para pesquisar.")
            continue
        termo = input("Pesquisar por título ou texto: ").strip().lower()
        if not termo:
            print("Digite um termo para pesquisar.")
            continue
        encontrados = [
            i for i, item in enumerate(artigos)
            if termo in item["titulo"].lower()
            or termo in item["texto"].lower()
        ]
        if not encontrados:
            print("Nenhum artigo encontrado.")
        else:
            for i in encontrados:
                print(f"[{i + 1}] {artigos[i]['titulo']}")
            print(f"{len(encontrados)} resultado(s)")

    elif op == "4":
        if not artigos:
            print("Nenhum artigo cadastrado.")
            continue
        try:
            n = int(input(f"Qual artigo quer editar (1 a {len(artigos)})? ").strip())
        except ValueError:
            print("Número inválido.")
            continue
        if n < 1 or n > len(artigos):
            print("Artigo não existe.")
            continue
        novo_titulo = input("Novo título: ").strip()
        novo_texto = input("Novo texto: ").strip()
        if not novo_titulo or not novo_texto:
            print("Título e texto são obrigatórios.")
            continue
        artigos[n - 1] = {"titulo": novo_titulo, "texto": novo_texto}
        print("Artigo editado!")

    elif op == "5":
        if not artigos:
            print("Nenhum artigo cadastrado.")
            continue
        try:
            n = int(input(f"Qual artigo quer apagar (1 a {len(artigos)})? ").strip())
        except ValueError:
            print("Número inválido.")
            continue
        if n < 1 or n > len(artigos):
            print("Artigo não existe.")
            continue
        artigos = [item for i, item in enumerate(artigos) if i != n - 1]
        print("Artigo apagado!")

    elif op == "6":
        if not artigos:
            print("Nenhum artigo cadastrado.")
            continue
        for i, item in enumerate(artigos):
            print(f"[{i + 1}] {item['titulo']}")

    elif op == "0":
        print("Encerrando...")
        break

    else:
        print("Opção inválida.")
