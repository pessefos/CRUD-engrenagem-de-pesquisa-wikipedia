menu = {
    "1": "criar artigo",
    "2": "ler artigo",
    "3": "pesquisar",
    "4": "editar artigo",
    "5": "apagar artigo",
    "6": "ver todos",
    "0": "sair",
}

rodando = True

while rodando:
    print("\n--- WIKIPEDIA ---")
    for chave, descricao in menu.items():
        print(chave, "-", descricao)
    op = input("opcao: ")

    if op not in menu:
        print("opcao invalida")

    # criar
    elif op == "1":
        titulo = input("titulo: ").strip()
        texto = input("texto: ").strip()
        if titulo == "" or texto == "":
            print("nao pode ficar vazio")
        else:
            artigos.append([titulo, texto])
            print("artigo criado na posicao", str(len(artigos)) + "!")

    # ler
    elif op == "2":
        n = input("qual artigo (1 a " + str(len(artigos)) + ")? ")
        if n.isdecimal() and 1 <= int(n) <= len(artigos):
            titulo, texto = artigos[int(n) - 1]
            print()
            print(titulo)
            print(texto)
        else:
            print("artigo nao existe")

    # pesquisar
    elif op == "3":
        busca = input("pesquisar: ").strip().lower()
        if busca == "":
            print("digite algo para pesquisar")
        else:
            achados = {}  # dicionario: posicao -> titulo
            for i in range(len(artigos)):
                titulo_min, texto_min = map(str.lower, artigos[i])
                if busca in titulo_min or busca in texto_min:
                    achados[i + 1] = artigos[i][0]
            if len(achados) == 0:
                print("nao encontrei nada")
            else:
                for posicao, titulo in achados.items():
                    print(posicao, "-", titulo)
                print(len(achados), "resultado(s)")

    # editar
    elif op == "4":
        n = input("qual artigo quer editar (1 a " + str(len(artigos)) + ")? ")
        if n.isdecimal() and 1 <= int(n) <= len(artigos):
            novo_titulo = input("novo titulo: ").strip()
            novo_texto = input("novo texto: ").strip()
            if novo_titulo == "" or novo_texto == "":
                print("nao pode ficar vazio")
            else:
                artigos[int(n) - 1] = [novo_titulo, novo_texto]
                print("artigo editado!")
        else:
            print("artigo nao existe")

    # apagar
    elif op == "5":
        n = input("qual artigo quer apagar (1 a " + str(len(artigos)) + ")? ")
        if n.isdecimal() and 1 <= int(n) <= len(artigos):
            artigos.pop(int(n) - 1)
            print("artigo apagado!")
        else:
            print("artigo nao existe")

    # ver todos
    elif op == "6":
        if len(artigos) == 0:
            print("nenhum artigo ainda")
        else:
            for i in range(len(artigos)):
                print(i + 1, "-", artigos[i][0])

    # sair
    elif op == "0":
        rodando = False
        print("tchau!")
