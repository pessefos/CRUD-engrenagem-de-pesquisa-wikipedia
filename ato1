titulos = ["", "", "", "", ""]
textos = ["", "", "", "", ""]
validos = ["1", "2", "3", "4", "5"]
rodando = True

while rodando:
    print("\n--- WIKIPEDIA ---")
    print("1 - criar artigo")
    print("2 - ler artigo")
    print("3 - pesquisar")
    print("4 - editar artigo")
    print("5 - apagar artigo")
    print("6 - ver todos")
    print("0 - sair")
    op = input("opcao: ")

    # criar
    if op == "1":
        titulo = input("titulo: ")
        texto = input("texto: ")
        if titulo == "" or texto == "":
            print("nao pode ficar vazio")
        elif "" in titulos:
            i = titulos.index("")
            titulos[i] = titulo
            textos[i] = texto
            print("artigo criado na posicao", str(i + 1) + "!")
        else:
            print("acabou o espaco, apague algum artigo")

    # ler
    elif op == "2":
        n = input("qual artigo (1 a 5)? ")
        if n in validos and titulos[int(n) - 1] != "":
            print()
            print(titulos[int(n) - 1])
            print(textos[int(n) - 1])
        else:
            print("artigo nao existe")

    # pesquisar
    elif op == "3":
        busca = input("pesquisar: ")
        achou = 0
        for i in range(5):
            if titulos[i] != "" and (busca in titulos[i] or busca in textos[i]):
                print(i + 1, "-", titulos[i])
                achou += 1
        if achou == 0:
            print("nao encontrei nada")
        else:
            print(achou, "resultado(s)")

    # editar
    elif op == "4":
        n = input("qual artigo quer editar (1 a 5)? ")
        novo_titulo = input("novo titulo: ")
        novo_texto = input("novo texto: ")
        if novo_titulo == "" or novo_texto == "":
            print("nao pode ficar vazio")
        elif n in validos and titulos[int(n) - 1] != "":
            titulos[int(n) - 1] = novo_titulo
            textos[int(n) - 1] = novo_texto
            print("artigo editado!")
        else:
            print("artigo nao existe")

    # apagar
    elif op == "5":
        n = input("qual artigo quer apagar (1 a 5)? ")
        if n in validos and titulos[int(n) - 1] != "":
            titulos[int(n) - 1] = ""
            textos[int(n) - 1] = ""
            print("artigo apagado!")
        else:
            print("artigo nao existe")

    # ver todos
    elif op == "6":
        total = 0
        for i in range(5):
            if titulos[i] != "":
                print(i + 1, "-", titulos[i])
                total += 1
        if total == 0:
            print("nenhum artigo ainda")

    # sair
    elif op == "0":
        rodando = False
        print("tchau!")

    else:
        print("opcao invalida")
